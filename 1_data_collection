import yfinance as yf
import pandas as pd
from pathlib import Path
from datetime import date

# ── Cấu hình ──────────────────────────────────────────────
TICKERS = {
    "SP500": "^GSPC",
    "VIX":   "^VIX",
    "Gold":  "GC=F",
    "IEF":   "IEF",
    "JPY":   "JPY=X",
}

START_DATE = "2023-01-01"
END_DATE   = date.today().strftime("%Y-%m-%d")

ASSETS_WITH_VOLUME = {"SP500", "Gold", "IEF"}

OUTPUT_PATH = Path("data/raw_market_data.csv")
# ──────────────────────────────────────────────────────────


def download_prices(tickers: dict, start: str, end: str) -> pd.DataFrame:
    frames = []

    for name, ticker in tickers.items():
        print(f"Downloading: {name} ({ticker})...")
        raw = yf.download(
            ticker,
            start=start,
            end=end,
            auto_adjust=True,
            progress=False,
        )

        if raw.empty:
            print(f"  WARNING: No data for {ticker}, skipping.")
            continue

        if name in ASSETS_WITH_VOLUME:
            df = raw[["Close", "Volume"]].copy()
            df.columns = [f"{name}_Close", f"{name}_Volume"]
        else:
            df = raw[["Close"]].copy()
            df.columns = [f"{name}_Close"]

        frames.append(df)

    combined = pd.concat(frames, axis=1)
    sp500_days = combined["SP500_Close"].dropna().index
    combined   = combined.loc[sp500_days]
    combined   = combined.ffill()

    return combined


def validate(df: pd.DataFrame):
    print(f"\nKiem tra data:")
    print(f"   Shape  : {df.shape}")
    print(f"   Tu {df.index[0].date()} den {df.index[-1].date()}")
    print(f"   So ngay: {len(df)}")

    missing = df.isnull().sum()
    if missing.any():
        print(f"\n   WARNING - Missing values:")
        print(missing[missing > 0])
    else:
        print(f"   Missing: Khong co")

    checks = {
        "SP500_Close": (3000, 7000),
        "VIX_Close":   (10, 90),
        "Gold_Close":  (1500, 3500),
        "IEF_Close":   (85, 115),
        "JPY_Close":   (100, 165),
    }
    print(f"\n   Range check:")
    for col, (lo, hi) in checks.items():
        mn, mx = df[col].min(), df[col].max()
        ok = "OK" if lo <= mn and mx <= hi else "WARNING"
        print(f"   {ok} {col}: {mn:.2f} - {mx:.2f}")

    print(f"\n   Columns: {list(df.columns)}")


def main():
    OUTPUT_PATH.parent.mkdir(parents=True, exist_ok=True)

    print(f"Lay data tu {START_DATE} den {END_DATE}")

    df = download_prices(TICKERS, START_DATE, END_DATE)
    validate(df)

    df.to_csv(OUTPUT_PATH)
    print(f"\nSaved -> {OUTPUT_PATH}")


if __name__ == "__main__":
    main()
